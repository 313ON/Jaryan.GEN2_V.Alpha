# Prisma CLI connection. Keep this separate from the runtime adapter URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# API runtime connection. Must be a direct PostgreSQL TCP URL.
PRISMA_DIRECT_TCP_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Approved by Operations for the deployment target.
PORT=3001
HOST=0.0.0.0
NODE_ENV=production
