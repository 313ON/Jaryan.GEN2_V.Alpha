{
  "name": "jaryan-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run build --workspace @jaryan/shared-domain && npm run build --workspace @jaryan/shared-infrastructure && npm run build --workspace @jaryan/shared-application && npm run build --workspace @jaryan/web && npm run build --workspace @jaryan/api",
    "db:provision:baseline": "node scripts/provision-release-baseline.mjs",
    "release:preflight": "node scripts/verify-release-preflight.mjs",
    "activation:readiness": "node scripts/verify-production-activation.mjs",
    "recovery:verify:local": "npm run build --workspace @jaryan/shared-infrastructure && node scripts/verify-local-recovery.mjs",
    "dev": "npm run dev --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "prisma": "^7.9.1",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "engines": {
    "node": ">=22.0.0 <23",
    "npm": ">=10.0.0 <11"
  }
}
