{
  "name": "@jaryan/shared-infrastructure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./database/repositories/durable-calculation-snapshot.repository.js": {
      "types": "./dist/database/repositories/durable-calculation-snapshot.repository.d.ts",
      "import": "./dist/database/repositories/durable-calculation-snapshot.repository.js"
    },
    "./database/database.module.js": {
      "types": "./dist/database/database.module.d.ts",
      "import": "./dist/database/database.module.js"
    },
    "./database/repositories/project-member.repository.js": {
      "types": "./dist/database/repositories/project-member.repository.d.ts",
      "import": "./dist/database/repositories/project-member.repository.js"
    },
    "./database/repositories/project.repository.js": {
      "types": "./dist/database/repositories/project.repository.d.ts",
      "import": "./dist/database/repositories/project.repository.js"
    },
    "./database/repositories/session.repository.js": {
      "types": "./dist/database/repositories/session.repository.d.ts",
      "import": "./dist/database/repositories/session.repository.js"
    },
    "./database/repositories/user.repository.js": {
      "types": "./dist/database/repositories/user.repository.d.ts",
      "import": "./dist/database/repositories/user.repository.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@jaryan/shared-application": "0.1.0",
    "@jaryan/shared-domain": "0.1.0"
  }
}
